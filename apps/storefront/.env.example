# Copy to .env and fill in the blanks. Never commit .env.
# NEXT_PUBLIC_ values are sent to the browser: never put a secret in one.

# Where the /api/* rewrite sends requests (task 4.5). Server-side only.
API_INTERNAL_URL="http://localhost:3002"

# This site's own address (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public address of product images. Set in phase 7, when the storage bucket is created.
NEXT_PUBLIC_IMAGE_BASE_URL=""

# Leave empty locally.
SENTRY_DSN=""

# Vercel only: the API project's "Protection Bypass for Automation" secret (D-151).
# Leave empty locally. Server-side only, never NEXT_PUBLIC_.
API_PROTECTION_BYPASS=""
