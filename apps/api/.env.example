# Copy to .env and fill in the blanks. Never commit .env.

# ── Database (local Supabase: `npx supabase start`) ─────────────
# Pooled connection, used by the running app (D-083).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Direct connection, used by Prisma migrations. Locally the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── Supabase Storage (product images) ──────────────────────────
SUPABASE_URL="http://127.0.0.1:54321"
# SECRET_KEY printed by `npx supabase start`. Server-only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=""

# ── Payments: Paymob test mode (phase 9) ───────────────────────
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_CARD_INTEGRATION_ID=""

# ── Email (D-085) ──────────────────────────────────────────────
# Locally, email goes to Mailpit (http://127.0.0.1:54324); Resend is only used in the demo.
RESEND_API_KEY=""
EMAIL_FROM="Beauty Store <no-reply@localhost>"

# ── Google sign-in (phase 6) ───────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Daily job (/api/v1/jobs/daily) ─────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ── Frontend addresses (links in emails, allowed origins) ─────
STOREFRONT_URL="http://localhost:3000"
DASHBOARD_URL="http://localhost:3001"

# ── Error reporting: leave empty locally (errors print to the console) ──
SENTRY_DSN=""
