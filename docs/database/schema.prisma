// Beauty & Cosmetics E-commerce Platform — Prisma schema
// Source of truth: "Database Design" document, approved 8 October 2026 (D-101 to D-120).
//
// Conventions (D-101 to D-107):
// - UUID primary keys (time-ordered v7), mapped to snake_case tables and columns.
// - created_at / updated_at as timestamptz on every table.
// - Money is Decimal(12,2) with a currency column; never Float.
// - Rules Prisma can't express (CHECK constraints, partial indexes, triggers,
//   Row Level Security, the order-number start value) live in
//   prisma/sql/constraints_and_security.sql, applied as a custom migration.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, citext]
}

// ─────────────────────────────────────────────────────────────
// Enums (D-105)
// ─────────────────────────────────────────────────────────────

enum Locale {
  en
  ar

  @@map("locale")
}

enum RecordStatus {
  ACTIVE
  ARCHIVED

  @@map("record_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum OptionKind {
  SHADE
  SIZE
  SCENT

  @@map("option_kind")
}

enum CustomerStatus {
  ACTIVE
  ANONYMIZED

  @@map("customer_status")
}

enum StaffRole {
  ADMIN
  STAFF

  @@map("staff_role")
}

enum StaffStatus {
  INVITED
  ACTIVE
  DEACTIVATED

  @@map("staff_status")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  STAFF_INVITE

  @@map("auth_token_purpose")
}

enum OrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED_TO_SENDER

  @@map("order_status")
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED

  @@map("payment_status")
}

enum PaymentMethod {
  CARD
  COD
  WALLET

  @@map("payment_method")
}

enum PaymentProviderName {
  PAYMOB

  @@map("payment_provider_name")
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_attempt_status")
}

enum RefundMethod {
  PROVIDER
  BANK_TRANSFER
  WALLET_TRANSFER
  CASH

  @@map("refund_method")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("refund_status")
}

enum ReturnDisposition {
  RESTOCK
  WRITE_OFF

  @@map("return_disposition")
}

enum StatusActor {
  CUSTOMER
  STAFF
  SYSTEM
  PAYMENT_WEBHOOK

  @@map("status_actor")
}

enum StockMovementReason {
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_EXPIRED
  RETURNED_TO_SENDER
  RETURN_RESTOCKED
  RECEIVED
  CORRECTION
  DAMAGED

  @@map("stock_movement_reason")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED

  @@map("email_status")
}

// ─────────────────────────────────────────────────────────────
// 4.1 Catalog (13 tables)
// ─────────────────────────────────────────────────────────────

model Brand {
  id             String             @id @default(uuid(7)) @db.Uuid
  name           String             @unique @db.Citext
  slug           String             @unique
  logoStorageKey String?            @map("logo_storage_key")
  status         RecordStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations   BrandTranslation[]
  products       Product[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "brands_name_trgm_idx")
  @@map("brands")
}

model BrandTranslation {
  brandId     String   @map("brand_id") @db.Uuid
  locale      Locale
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([brandId, locale])
  @@map("brand_translations")
}

model Category {
  id           String                @id @default(uuid(7)) @db.Uuid
  parentId     String?               @map("parent_id") @db.Uuid
  slug         String                @unique
  sortOrder    Int                   @default(0) @map("sort_order")
  status       RecordStatus          @default(ACTIVE)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  categoryId  String   @map("category_id") @db.Uuid
  locale      Locale
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "category_translations_name_trgm_idx")
  @@map("category_translations")
}

model Product {
  id           String               @id @default(uuid(7)) @db.Uuid
  brandId      String               @map("brand_id") @db.Uuid
  categoryId   String               @map("category_id") @db.Uuid
  slug         String               @unique
  status       ProductStatus        @default(DRAFT)
  activatedAt  DateTime?            @map("activated_at") @db.Timestamptz(6)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand        Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations ProductTranslation[]
  options      ProductOption[]
  variants     Variant[]
  images       ProductImage[]
  featured     FeaturedProduct?

  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([activatedAt])
  @@map("products")
}

model ProductTranslation {
  productId   String   @map("product_id") @db.Uuid
  locale      Locale
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_translations_name_trgm_idx")
  @@map("product_translations")
}

model ProductOption {
  id        String        @id @default(uuid(7)) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  kind      OptionKind
  position  Int
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    OptionValue[]

  @@unique([productId, kind])
  @@unique([productId, position])
  @@map("product_options")
}

model OptionValue {
  id           String                   @id @default(uuid(7)) @db.Uuid
  optionId     String                   @map("option_id") @db.Uuid
  position     Int
  swatchHex    String?                  @map("swatch_hex") @db.Char(7)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  option       ProductOption            @relation(fields: [optionId], references: [id], onDelete: Cascade)
  translations OptionValueTranslation[]
  variantLinks VariantOptionValue[]

  @@index([optionId, position])
  @@map("option_values")
}

model OptionValueTranslation {
  optionValueId String      @map("option_value_id") @db.Uuid
  locale        Locale
  label         String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  optionValue   OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([optionValueId, locale])
  @@map("option_value_translations")
}

model Variant {
  id             String               @id @default(uuid(7)) @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  sku            String               @unique @db.Citext
  // Option value IDs in option-position order, joined; "" for a product without options (D-110).
  optionKey      String               @default("") @map("option_key")
  price          Decimal              @db.Decimal(12, 2)
  currency       String               @default("EGP") @db.Char(3)
  stockQuantity  Int                  @default(0) @map("stock_quantity")
  isEnabled      Boolean              @default(true) @map("is_enabled")
  status         RecordStatus         @default(ACTIVE)
  imageId        String?              @map("image_id") @db.Uuid
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  image          ProductImage?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  optionValues   VariantOptionValue[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, optionKey])
  @@index([imageId])
  @@map("variants")
}

model VariantOptionValue {
  variantId     String      @map("variant_id") @db.Uuid
  optionValueId String      @map("option_value_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant       Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model ProductImage {
  id           String                    @id @default(uuid(7)) @db.Uuid
  productId    String                    @map("product_id") @db.Uuid
  storageKey   String                    @map("storage_key")
  width        Int
  height       Int
  position     Int
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductImageTranslation[]
  variants     Variant[]

  @@index([productId, position])
  @@map("product_images")
}

model ProductImageTranslation {
  imageId   String       @map("image_id") @db.Uuid
  locale    Locale
  altText   String       @map("alt_text")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  image     ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([imageId, locale])
  @@map("product_image_translations")
}

// ─────────────────────────────────────────────────────────────
// 4.2 Store configuration (6 tables)
// ─────────────────────────────────────────────────────────────

model Banner {
  id           String              @id @default(uuid(7)) @db.Uuid
  storageKey   String              @map("storage_key")
  linkUrl      String?             @map("link_url")
  position     Int
  startsAt     DateTime?           @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?           @map("ends_at") @db.Timestamptz(6)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations BannerTranslation[]

  @@map("banners")
}

model BannerTranslation {
  bannerId  String   @map("banner_id") @db.Uuid
  locale    Locale
  altText   String   @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  banner    Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@id([bannerId, locale])
  @@map("banner_translations")
}

model FeaturedProduct {
  productId String   @id @map("product_id") @db.Uuid
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("featured_products")
}

model Governorate {
  code         String                   @id @db.VarChar(8)
  shippingFee  Decimal                  @map("shipping_fee") @db.Decimal(12, 2)
  currency     String                   @default("EGP") @db.Char(3)
  isEnabled    Boolean                  @default(true) @map("is_enabled")
  sortOrder    Int                      @default(0) @map("sort_order")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations GovernorateTranslation[]
  addresses    CustomerAddress[]
  orders       Order[]

  @@map("governorates")
}

model GovernorateTranslation {
  code        String      @db.VarChar(8)
  locale      Locale
  name        String
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  governorate Governorate @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([code, locale])
  @@map("governorate_translations")
}

// Exactly one row, id = 1 (CHECK in constraints_and_security.sql).
model StoreSettings {
  id                      Int      @id @default(1) @db.SmallInt
  codMaxOrderValue        Decimal? @map("cod_max_order_value") @db.Decimal(12, 2)
  freeShippingThreshold   Decimal? @map("free_shipping_threshold") @db.Decimal(12, 2)
  returnWindowDays        Int      @default(14) @map("return_window_days")
  lowStockThreshold       Int      @default(5) @map("low_stock_threshold")
  newOrderEmailEnabled    Boolean  @default(false) @map("new_order_email_enabled")
  newOrderEmailRecipients String[] @default([]) @map("new_order_email_recipients")
  contactEmail            String?  @map("contact_email") @db.Citext
  contactPhone            String?  @map("contact_phone")
  version                 Int      @default(1)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

// ─────────────────────────────────────────────────────────────
// 4.3 Customers, staff and authentication (8 tables)
// ─────────────────────────────────────────────────────────────

model Customer {
  id              String            @id @default(uuid(7)) @db.Uuid
  email           String?           @unique @db.Citext
  emailVerifiedAt DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String?           @map("password_hash")
  googleSubject   String?           @unique @map("google_subject")
  firstName       String?           @map("first_name")
  lastName        String?           @map("last_name")
  phone           String?
  status          CustomerStatus    @default(ACTIVE)
  anonymizedAt    DateTime?         @map("anonymized_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses       CustomerAddress[]
  sessions        CustomerSession[]
  authTokens      AuthToken[]
  cart            Cart?
  orders          Order[]

  @@map("customers")
}

model CustomerAddress {
  id              String      @id @default(uuid(7)) @db.Uuid
  customerId      String      @map("customer_id") @db.Uuid
  recipientName   String      @map("recipient_name")
  phone           String
  governorateCode String      @map("governorate_code") @db.VarChar(8)
  cityArea        String      @map("city_area")
  street          String
  building        String
  floor           String?
  apartment       String?
  landmark        String?
  isDefault       Boolean     @default(false) @map("is_default")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  governorate     Governorate @relation(fields: [governorateCode], references: [code], onDelete: Restrict)

  @@index([customerId])
  @@index([governorateCode])
  @@map("customer_addresses")
}

model CustomerSession {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model StaffUser {
  id                  String               @id @default(uuid(7)) @db.Uuid
  email               String               @unique @db.Citext
  passwordHash        String?              @map("password_hash")
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  role                StaffRole
  status              StaffStatus          @default(INVITED)
  locale              Locale               @default(en)
  totpSecretEncrypted String?              @map("totp_secret_encrypted")
  totpEnabledAt       DateTime?            @map("totp_enabled_at") @db.Timestamptz(6)
  failedLoginCount    Int                  @default(0) @map("failed_login_count")
  lockedUntil         DateTime?            @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions            StaffSession[]
  recoveryCodes       StaffRecoveryCode[]
  authTokens          AuthToken[]
  auditLogs           AuditLog[]
  statusChanges       OrderStatusHistory[]
  refunds             Refund[]
  returns             Return[]
  stockMovements      StockMovement[]
  collectedPayments   Payment[]

  @@map("staff_users")
}

model StaffSession {
  id              String    @id @default(uuid(7)) @db.Uuid
  staffId         String    @map("staff_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  // Absolute cap: 12 hours after sign-in (AD-01).
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  // Idle limit: 30 minutes after last_seen_at (AD-01).
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  twoFactorPassed Boolean   @default(false) @map("two_factor_passed")
  ip              String?   @db.Inet
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  staff           StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model StaffRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_recovery_codes")
}

// Exactly one of customer_id / staff_id is set (CHECK in constraints_and_security.sql).
model AuthToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash")
  customerId String?          @map("customer_id") @db.Uuid
  staffId    String?          @map("staff_id") @db.Uuid
  newEmail   String?          @map("new_email") @db.Citext
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff      StaffUser?       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([staffId])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model RateLimitCounter {
  key          String   @id
  count        Int      @default(0)
  windowEndsAt DateTime @map("window_ends_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([windowEndsAt])
  @@map("rate_limit_counters")
}

// ─────────────────────────────────────────────────────────────
// 4.4 Cart (2 tables) — signed-in customers only (D-113)
// ─────────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(uuid(7)) @db.Uuid
  customerId String     @unique @map("customer_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────
// 4.5 Orders, payments and stock (9 tables)
// ─────────────────────────────────────────────────────────────

model Order {
  id                 String               @id @default(uuid(7)) @db.Uuid
  // Customer-facing number; sequence restarts at 100001 (constraints_and_security.sql).
  orderNumber        BigInt               @unique @default(autoincrement()) @map("order_number")
  customerId         String?              @map("customer_id") @db.Uuid
  guestTokenHash     String?              @unique @map("guest_token_hash")
  status             OrderStatus
  paymentStatus      PaymentStatus        @default(UNPAID) @map("payment_status")
  paymentMethod      PaymentMethod        @map("payment_method")
  // Contact snapshot (D-114)
  contactName        String               @map("contact_name")
  contactEmail       String               @map("contact_email") @db.Citext
  contactPhone       String               @map("contact_phone")
  // Delivery address snapshot (D-114)
  recipientName      String               @map("recipient_name")
  shipPhone          String               @map("ship_phone")
  governorateCode    String               @map("governorate_code") @db.VarChar(8)
  governorateName    String               @map("governorate_name")
  cityArea           String               @map("city_area")
  street             String
  building           String
  floor              String?
  apartment          String?
  landmark           String?
  note               String?              @db.VarChar(500)
  // Totals
  currency           String               @default("EGP") @db.Char(3)
  subtotal           Decimal              @db.Decimal(12, 2)
  shippingFee        Decimal              @map("shipping_fee") @db.Decimal(12, 2)
  total              Decimal              @db.Decimal(12, 2)
  // Lifecycle
  expiresAt          DateTime?            @map("expires_at") @db.Timestamptz(6)
  courierName        String?              @map("courier_name")
  trackingNumber     String?              @map("tracking_number")
  shippedAt          DateTime?            @map("shipped_at") @db.Timestamptz(6)
  deliveredAt        DateTime?            @map("delivered_at") @db.Timestamptz(6)
  cancelledAt        DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?              @map("cancellation_reason")
  version            Int                  @default(1)
  anonymizedAt       DateTime?            @map("anonymized_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer           Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  governorate        Governorate          @relation(fields: [governorateCode], references: [code], onDelete: Restrict)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  refunds            Refund[]
  returns            Return[]
  stockMovements     StockMovement[]
  idempotencyKeys    IdempotencyKey[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([contactEmail])
  @@index([contactPhone])
  @@index([governorateCode])
  @@map("orders")
}

model OrderItem {
  id            String       @id @default(uuid(7)) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  variantId     String       @map("variant_id") @db.Uuid
  // Snapshot of the product at purchase time (D-114)
  productName   String       @map("product_name")
  brandName     String       @map("brand_name")
  optionSummary String       @default("") @map("option_summary")
  sku           String
  unitPrice     Decimal      @map("unit_price") @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal      @map("line_total") @db.Decimal(12, 2)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant       Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems   ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  StatusActor  @map("actor_type")
  staffId    String?      @map("staff_id") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff      StaffUser?   @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([staffId])
  @@map("order_status_history")
}

// One row per payment attempt (D-115). COD rows have no provider (CHECK).
model Payment {
  id                 String               @id @default(uuid(7)) @db.Uuid
  orderId            String               @map("order_id") @db.Uuid
  method             PaymentMethod
  provider           PaymentProviderName?
  providerReference  String?              @map("provider_reference")
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @default("EGP") @db.Char(3)
  status             PaymentAttemptStatus @default(PENDING)
  succeededAt        DateTime?            @map("succeeded_at") @db.Timestamptz(6)
  collectedByStaffId String?              @map("collected_by_staff_id") @db.Uuid
  failureReason      String?              @map("failure_reason")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  collectedBy        StaffUser?           @relation(fields: [collectedByStaffId], references: [id], onDelete: Restrict)
  refunds            Refund[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([succeededAt])
  @@index([collectedByStaffId])
  @@map("payments")
}

model Refund {
  id                String       @id @default(uuid(7)) @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  paymentId         String?      @map("payment_id") @db.Uuid
  returnId          String?      @map("return_id") @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("EGP") @db.Char(3)
  method            RefundMethod
  status            RefundStatus @default(PENDING)
  providerReference String?      @map("provider_reference")
  idempotencyKey    String       @unique @map("idempotency_key")
  reason            String?
  // Empty for automatic refunds made by the system (cancellation, late payment).
  staffId           String?      @map("staff_id") @db.Uuid
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  return            Return?      @relation(fields: [returnId], references: [id], onDelete: Restrict)
  staff             StaffUser?   @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paymentId])
  @@index([returnId])
  @@index([staffId])
  @@index([completedAt])
  @@map("refunds")
}

model Return {
  id             String          @id @default(uuid(7)) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  staffId        String          @map("staff_id") @db.Uuid
  note           String?
  // Required when accepted outside the return window (AD-06).
  overrideReason String?         @map("override_reason")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff          StaffUser       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  items          ReturnItem[]
  refunds        Refund[]
  stockMovements StockMovement[]

  @@index([orderId])
  @@index([staffId])
  @@map("returns")
}

model ReturnItem {
  id          String            @id @default(uuid(7)) @db.Uuid
  returnId    String            @map("return_id") @db.Uuid
  orderItemId String            @map("order_item_id") @db.Uuid
  quantity    Int
  disposition ReturnDisposition
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  return      Return            @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

model PaymentWebhookEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  provider       PaymentProviderName
  eventId        String              @map("event_id")
  eventType      String              @map("event_type")
  payload        Json
  signatureValid Boolean             @map("signature_valid")
  receivedAt     DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime?           @map("processed_at") @db.Timestamptz(6)
  error          String?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("payment_webhook_events")
}

model StockMovement {
  id             String              @id @default(uuid(7)) @db.Uuid
  variantId      String              @map("variant_id") @db.Uuid
  quantityChange Int                 @map("quantity_change")
  stockAfter     Int                 @map("stock_after")
  reason         StockMovementReason
  orderId        String?             @map("order_id") @db.Uuid
  returnId       String?             @map("return_id") @db.Uuid
  staffId        String?             @map("staff_id") @db.Uuid
  note           String?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant        Variant             @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order          Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  return         Return?             @relation(fields: [returnId], references: [id], onDelete: Restrict)
  staff          StaffUser?          @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([returnId])
  @@index([staffId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// 4.6 System records (3 tables)
// ─────────────────────────────────────────────────────────────

model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  orderId        String?  @map("order_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([scope, key])
  @@index([expiresAt])
  @@index([orderId])
  @@map("idempotency_keys")
}

// Append-only: a trigger rejects UPDATE and DELETE (D-119).
model AuditLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  staffId    String?    @map("staff_id") @db.Uuid
  action     String
  entityType String     @map("entity_type")
  entityId   String     @map("entity_id")
  before     Json?
  after      Json?
  ip         String?    @db.Inet
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  staff      StaffUser? @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([staffId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailOutbox {
  id            String      @id @default(uuid(7)) @db.Uuid
  template      String
  toEmail       String      @map("to_email") @db.Citext
  locale        Locale      @default(en)
  payload       Json
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(6)
  lastError     String?     @map("last_error")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}
